{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {},
  "permissions": {
    "allow": [
      "Edit(//tmp/**)"
    ],
    "deny": [],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "sh /Users/charlie/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "atlassian@ecubelabs-agent-hub": true,
    "git-workflow@ecubelabs-agent-hub": true,
    "harness@harness-marketplace": true
  },
  "extraKnownMarketplaces": {
    "ecubelabs-agent-hub": {
      "source": {
        "source": "github",
        "repo": "Ecube-Labs/agent-hub"
      }
    },
    "harness-marketplace": {
      "source": {
        "source": "github",
        "repo": "revfactory/harness"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "telemetry.vercel.com"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "/tmp"
      ]
    },
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "git *",
      "yarn *",
      "kubectl *"
    ]
  },
  "effortLevel": "high",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "skipAutoPermissionPrompt": true
}
